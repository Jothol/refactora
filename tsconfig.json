{
  "compilerOptions": {
    // Module system
    "module": "ESNext",
    "moduleResolution": "Node",
    "target": "ES2022",

    // Turn off the strict “must match runtime exactly” module syntax mode
    "verbatimModuleSyntax": false,

    // Keep your nice strictness
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    // You can keep these if you like
    "jsx": "react-jsx",
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,

    // optional: root/out dirs later
    // "rootDir": "./src",
    // "outDir": "./dist",
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true
  }
}
